{
  "private": true,
  "version": "0.5.0",
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "test": "vitest run --config @mirta/testing/config",
    "build": "cross-env NODE_ENV=production pnpm --filter ./packages/* --filter ./projects/* run build:mono",
    "build:dev": "pnpm --filter ./packages/* --filter ./projects/* run build:mono",
    "release": "mirta release",
    "wb:deploy": "pnpm --filter ./projects/chatbot-demo run wb:deploy"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mirta/cli": "0.5.2",
    "@mirta/globals": "0.5.2",
    "@mirta/rollup": "0.5.2",
    "@mirta/testing": "0.5.2",
    "@mirta/tsconfig": "0.5.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.4",
    "@vitest/eslint-plugin": "^1.6.12",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "globals": "^17.12.0",
    "lint-staged": "^16.4.0",
    "rollup": "^4.59.0",
    "simple-git-hooks": "^2.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0",
    "vitest-mock-extended": "^4.0.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "workspaces": [
    "packages/*",
    "projects/*"
  ],
  "packageManager": "pnpm@10.33.2"
}
