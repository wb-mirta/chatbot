{
  "private": true,
  "version": "0.4.8",
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "test": "vitest run --config @mirta/testing/config",
    "build": "cross-env NODE_ENV=production pnpm --filter ./packages/* --filter ./projects/* run build:mono",
    "build:dev": "pnpm --filter ./packages/* --filter ./projects/* run build:mono",
    "release": "mirta release",
    "wb:deploy": "pnpm --filter ./projects/chatbot-demo run wb:deploy"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@mirta/cli": "0.4.8",
    "@mirta/globals": "0.4.8",
    "@mirta/rollup": "0.4.8",
    "@mirta/testing": "0.4.8",
    "@mirta/tsconfig": "0.4.8",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@types/node": "^24.10.9",
    "@vitest/eslint-plugin": "^1.6.4",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "lint-staged": "^16.2.7",
    "rollup": "^4.55.1",
    "simple-git-hooks": "^2.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.8",
    "vitest-mock-extended": "^3.1.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "workspaces": [
    "packages/*",
    "projects/*"
  ],
  "packageManager": "pnpm@10.28.1"
}
